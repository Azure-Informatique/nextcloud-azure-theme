{
  "name": "azure_theme",
  "version": "1.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "^22.14 || ^24"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('css',{recursive:true,force:true})\"",
    "build:images": "node scripts/build-images.js",
    "build:page-css": "sass scss/page/azure-page.scss css/azure-page.css --style=compressed --no-source-map",
    "build:theme-css": "node scripts/build-theme-css.js",
    "build:login-css": "sass scss/azure-login.scss css/azure-login.css --style=compressed --no-source-map",
    "build:palette-css": "sass scss/azure-palette-light.scss:css/azure-palette-light.css scss/azure-palette-dark.scss:css/azure-palette-dark.css scss/azure-palette-system.scss:css/azure-palette-system.css scss/azure-public.scss:css/azure-public.css scss/azure-settings.scss:css/azure-settings.css --style=compressed --no-source-map",
    "build:version-css": "node scripts/build-version-css.js",
    "build:lower-has": "node scripts/lower-has.js css/azure-theme*.css css/azure-app-*.css css/azure-cadre*.css",
    "build:optimize-css": "node scripts/optimize-css.js css/*.css",
    "build:js": "webpack --config webpack.config.js",
    "build": "npm run build:images && npm run build:page-css && npm run build:theme-css && npm run build:login-css && npm run build:palette-css && npm run build:version-css && npm run build:lower-has && npm run build:optimize-css && npm run build:js",
    "watch:css": "sass --no-source-map --style=expanded --watch scss/page/azure-page.scss:css/azure-page.css scss/azure-login.scss:css/azure-login.css & node scripts/build-theme-css.js --watch",
    "watch:version-css": "node scripts/build-version-css.js --watch",
    "watch:js": "webpack --config webpack.config.js --watch",
    "watch": "npm run build:images && npm run watch:css & npm run watch:version-css",
    "lint": "eslint src js scripts webpack.config.js",
    "lint:fix": "eslint src js scripts webpack.config.js --fix",
    "stylelint": "stylelint \"scss/**/*.scss\" \"src/**/*.vue\"",
    "stylelint:fix": "stylelint \"scss/**/*.scss\" \"src/**/*.vue\" --fix",
    "l10n:pot": "php ${TRANSLATIONTOOL:-../translationtool.phar} create-pot-files"
  },
  "dependencies": {
    "@nextcloud/axios": "^2.5.1",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.0.1",
    "@nextcloud/vue": "^9.8.2",
    "vue": "^3.5.13",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/stylelint-config": "~3.1.1",
    "@vue/compiler-sfc": "^3.5.13",
    "css-loader": "^7.1.2",
    "eslint": "^10.12.0",
    "postcss": "^8.5.29",
    "sass": "^1.102.0",
    "style-loader": "^4.0.0",
    "stylelint": "^16.13.2",
    "stylelint-config-recommended-scss": "^15.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "vue-loader": "^17.4.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  }
}
